{
  "// PROFILE": "standard - Auto-accept edits (defaultMode acceptEdits); bash still prompts",

  "// PERMISSIONS": "What Claude can do automatically vs. needs to ask",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf *)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(sudo *)"
    ],
    "defaultMode": "acceptEdits"
  },

  "// SANDBOX": "Container-based isolation for bash commands. No domains pre-allowed; first access to a new domain prompts.",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git"],
    "network": {
      "allowedDomains": []
    }
  },

  "// DISPLAY": "Output and formatting preferences",
  "includeCoAuthoredBy": true
}
