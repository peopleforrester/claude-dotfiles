{
  "// STACK": "Python + FastAPI + SQLAlchemy + Alembic",

  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(alembic *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf *)",
      "Bash(curl * | bash)",
      "Bash(sudo *)",
      "Bash(pip install *)"
    ],
    "defaultMode": "acceptEdits"
  },

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git"],
    "network": {
      "allowedDomains": []
    }
  },

  "hooks": {
    "PostToolUse": [
      {
        "// DESCRIPTION": "Format Python with ruff after edit (matcher is the tool name; the command guards on extension)",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "if": "Edit(*.py)",
          "command": "FILE=$(cat | jq -r '.tool_input.file_path'); case \"$FILE\" in *.py) uv run ruff format \"$FILE\" 2>/dev/null || true;; esac"
        }]
      }
    ]
  },

  "includeCoAuthoredBy": true
}
