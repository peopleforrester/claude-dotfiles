{
  "// STACK": "Next.js 14 + TypeScript + Prisma + NextAuth",

  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf *)",
      "Bash(curl * | bash)",
      "Bash(sudo *)"
    ],
    "defaultMode": "acceptEdits"
  },

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git"],
    "network": {
      "allowedDomains": []
    }
  },

  "hooks": {
    "PostToolUse": [
      {
        "// DESCRIPTION": "Prettier on edited files (matcher is the tool name; prettier skips files it can't parse)",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "FILE=$(cat | jq -r '.tool_input.file_path') && npx prettier --write \"$FILE\" 2>/dev/null || true"
        }]
      },
      {
        "// DESCRIPTION": "Format Prisma schema after edit",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "if": "Edit(*.prisma)",
          "command": "FILE=$(cat | jq -r '.tool_input.file_path'); case \"$FILE\" in *.prisma) npx prisma format 2>/dev/null || true;; esac"
        }]
      }
    ]
  },

  "includeCoAuthoredBy": true
}
